# Copia este archivo a ".env" y rellena solo lo que quieras.
# Sin claves, el servidor funciona igual: catálogo de ejemplo + tiendas vía Overpass (gratis).

PORT=3000

# ---------- TIENDAS FÍSICAS CERCANAS ----------
# Proveedor: overpass (gratis, por defecto) | google | none
PLACES_PROVIDER=overpass
# Solo si PLACES_PROVIDER=google:
GOOGLE_PLACES_KEY=
# Radio de búsqueda en metros (recomendado 1500, máximo 3000)
SEARCH_RADIUS_M=1500

# ---------- BÚSQUEDA ONLINE (FASE 2) ----------
# SerpAPI (gratis ~100/mes). Sin clave -> catálogo de ejemplo.
SERPAPI_KEY=

# ---------- IA (solo en /recomendar, NUNCA automática) ----------
# Proveedor: gemini | claude | none
AI_PROVIDER=none
# Gemini (capa gratuita): https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Claude: https://console.anthropic.com
ANTHROPIC_API_KEY=

# ---------- Idioma/país ----------
SEARCH_COUNTRY=es
SEARCH_LANGUAGE=es
